[Unit]
Description=Axion Writer PostgreSQL backup
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=oneshot
User=root
EnvironmentFile=/root/projects/Writer/backend/.env
Environment=BACKUP_DIR=/var/backups/axion-writer
Environment=SERVICE_NAME=axion-writer
ExecStart=/root/projects/Writer/ops/backup-postgres.sh
